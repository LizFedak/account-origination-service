      "name": "📁 E2E Workflow",
      "item": [
        {
          "name": "POST /applications — should create a new application and return 201",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const suffix = Date.now();",
                  "pm.collectionVariables.set('e2eEmail', `alex.rivera+${suffix}@partner.example.com`);",
                  "pm.collectionVariables.set('partnerReferenceId', `partner-postman-${suffix}`);",
                  "pm.collectionVariables.set('requestTimestamp', new Date().toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('POST /applications — should create a new application and return 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test('Response envelope includes data and meta', function () {",
                  "  pm.expect(body).to.have.keys(['data', 'meta']);",
                  "  pm.expect(body.meta.correlationId).to.be.a('string');",
                  "  pm.expect(body.meta.timestamp).to.be.a('string');",
                  "});",
                  "pm.test('Created application includes all contract fields', function () {",
                  "  const required = ['id', 'status', 'productCode', 'channel', 'applicant', 'employment', 'funding', 'consents', 'requestedDebitCard', 'partnerReferenceId', 'riskTier', 'decisionReason', 'submittedAt', 'createdAt', 'updatedAt'];",
                  "  required.forEach((field) => pm.expect(body.data).to.have.property(field));",
                  "});",
                  "pm.test('Business logic sets submitted status and accepted consents', function () {",
                  "  pm.expect(body.data.status).to.eql('submitted');",
                  "  pm.expect(body.data.consents.privacyPolicyAccepted).to.eql(true);",
                  "  pm.expect(body.data.consents.eSignAccepted).to.eql(true);",
                  "  pm.expect(['low', 'standard', 'review']).to.include(body.data.riskTier);",
                  "});",
                  "pm.collectionVariables.set('e2eApplicationId', body.data.id);",
                  "pm.collectionVariables.set('applicationId', body.data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{apiKey}}"
              },
              {
                "key": "x-correlation-id",
                "value": "{{correlationId}}"
              },
