      "script": {
        "type": "text/javascript",
        "exec": [
          "const correlationId = `corr_demo_postman_${pm.variables.replaceIn('{{$guid}}')}`;",
          "pm.collectionVariables.set('correlationId', correlationId);",
          "console.log(`[Northstar Bank] ${pm.request.method} ${pm.request.url.toString()} correlationId=${correlationId}`);"
        ]
      }
    }
